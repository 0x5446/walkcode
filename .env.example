# WalkCode V3 channel-native runtime
#
# One env file configures one local runtime instance:
#   1 runtime = 1 channel = 1 bot/app identity = 1 coding agent
#
# To run both Claude Code and Codex, create two env files with different bot
# tokens and state paths, for example:
#   ~/.walkcode/telegram-claude.env
#   ~/.walkcode/telegram-codex.env

# Required: select exactly one channel.
WALKCODE_CHANNEL=telegram

# Required for Telegram.
TELEGRAM_BOT_TOKEN=123456:telegram-bot-token

# Recommended before real use. Comma-separated ids are accepted.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
# TELEGRAM_ALLOWED_USER_IDS=456789

# Required: bind this bot to exactly one coding agent.
# Use a separate bot/env/state/runtime for the other agent.
WALKCODE_AGENT=claude
# WALKCODE_AGENT=codex

# Required for clean local deployment: do not share state between agents.
WALKCODE_STATE_PATH=/Users/you/.walkcode/telegram-claude-state.json

# Default working directory for IM-started headless sessions.
WALKCODE_CWD=/Users/you/.walkcode/workspace

# Optional when Claude Code uses a non-default provider/profile.
# WALKCODE_CLAUDE_SETTINGS=/Users/you/.claude/profiles/vertex.json
# WALKCODE_CLAUDE_CLI_PATH=/Users/you/bin/claude

# Optional when Codex config/cache are not in the default ~/.codex locations.
# WALKCODE_CODEX_CONFIG=/Users/you/.codex/config.toml
# WALKCODE_CODEX_MODELS_CACHE=/Users/you/.codex/models_cache.json
# Advanced Codex app-server mode. Default auto uses the managed daemon control
# socket only when the Codex standalone daemon install exists; otherwise it
# falls back to stdio.
# Use daemon to force shared app-server, or stdio for local debugging.
# WALKCODE_CODEX_APP_SERVER_MODE=auto
# WALKCODE_CODEX_APP_SERVER_SOCKET=/Users/you/.codex/app-server-control/app-server-control.sock

# Optional Telegram routing for local TUI sessions observed through
# `walkcode native hook`. Use a forum supergroup chat id for automatic
# topic-per-session; set a thread id only when pinning observation to one topic.
# WALKCODE_TELEGRAM_TUI_CHAT_ID=123456789
# WALKCODE_TELEGRAM_TUI_THREAD_ID=77

# Optional real-environment gates. Leave disabled unless intentionally running
# real E2E checks.
# WALKCODE_E2E_TELEGRAM=1
# WALKCODE_E2E_TELEGRAM_CHAT_ID=123456789
# WALKCODE_E2E_CLAUDE_HEADLESS=1
# WALKCODE_E2E_CODEX_APP_SERVER=1
# WALKCODE_E2E_CWD=/Users/you/.walkcode/e2e/channel-native-smoke

# Lark/Feishu is a peer ChannelAdapter, not a lower-priority agent mode. Use it
# in a separate env file when V3 live Lark ingress is enabled:
#
# WALKCODE_CHANNEL=lark
# WALKCODE_AGENT=claude
# WALKCODE_STATE_PATH=/Users/you/.walkcode/lark-claude-state.json
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=xxx
# LARK_RECEIVE_ID=ou_xxx
# LARK_RECEIVE_ID_TYPE=open_id
# LARK_OPENAPI_DOMAIN=https://open.feishu.cn
