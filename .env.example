# WalkCode V3 channel-native runtime
#
# One env file configures one local runtime instance:
#   1 runtime = 1 profile = 1 channel = 1 bot/app identity = 1 coding agent
#
# The standard local deployment is four Lark/Feishu instances
# ({work, personal} x {claude, codex}), each with its own env file:
#   ~/.walkcode/work-claude.env       (company Feishu tenant)
#   ~/.walkcode/work-codex.env        (company Feishu tenant)
#   ~/.walkcode/personal-claude.env   (Lark tenant)
#   ~/.walkcode/personal-codex.env    (Lark tenant)

# ---------------------------------------------------------------------------
# Example: work-claude.env (Feishu/Lark channel)
# ---------------------------------------------------------------------------

# Recommended: names the instance. Derives the default state path
# (~/.walkcode/{profile}-{agent}-state.json) and the launchd label
# (com.walkcode.{profile}-{agent}). Lowercase letters, digits, dashes.
WALKCODE_PROFILE=work

# Required: select exactly one channel.
WALKCODE_CHANNEL=lark

# Required: bind this bot to exactly one coding agent.
# Use a separate bot/env/state/runtime for the other agent.
WALKCODE_AGENT=claude
# WALKCODE_AGENT=codex

# Required for Lark/Feishu.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# Tenant API domain: company Feishu vs personal Lark.
LARK_OPENAPI_DOMAIN=https://open.feishu.cn
# LARK_OPENAPI_DOMAIN=https://open.larksuite.com

# Recommended before real use. Comma-separated ids are accepted.
# LARK_ALLOWED_CHAT_IDS=oc_xxx
# LARK_ALLOWED_OPEN_IDS=ou_xxx

# Default working directory for IM-started headless sessions.
WALKCODE_CWD=/Users/you/.walkcode/workspace

# Optional: colon-separated allowlist enabling `/repo <dir> <task>` to start a
# session in a specific repository. Also the per-profile workspace boundary.
# WALKCODE_WORKSPACE_ROOTS=/Users/you/Documents/workspace

# Per-profile Claude Code isolation (credentials, settings, history).
# WALKCODE_CLAUDE_CONFIG_DIR=/Users/you/.claude-profiles/work
# Optional extras when Claude uses a non-default provider/profile.
# WALKCODE_CLAUDE_SETTINGS=/Users/you/.claude-profiles/work/settings.json
# WALKCODE_CLAUDE_CLI_PATH=/Users/you/bin/claude

# Session spawn surface. headless (default, ADR 0050 single-master UI):
# channel-born sessions spawn via the headless SDK, TUI sessions stay
# hook-observed read-only with takeover. daemon (explicit opt-in, ADR 0048
# dual-UI): channel-born sessions spawn as daemon bg workers — terminal can
# `claude attach`, Feishu gets the full v3 dual-surface loop; spawn failure
# falls back to headless automatically. Explicit daemon combined with
# WALKCODE_CLAUDE_DAEMON_MODE=off is a startup error.
# WALKCODE_CLAUDE_SPAWN_MODE=headless       # headless|daemon
# List-fallback adoption: register live daemon jobs walkcode has never seen
# (hook not configured, spool lost) as observed sessions. auto|off.
# WALKCODE_CLAUDE_LIST_ADOPT=auto

# Session-level listening for headless Claude sessions (ADR 0052). After a
# turn ends the event stream stays attached while background subagents keep
# working; it "goes off duty" (closes the worker; next message resumes it)
# only when the background-task ledger is empty and the stream stays quiet
# for the grace period — or, with tasks still pending but zero traffic, when
# the wait ceiling elapses (a visible warning is posted first; 0 = no ceiling).
# NOTE: the ceiling is an explicit give-up — late background results are NOT
# auto-delivered after it fires. Lowering it frees the worker sooner but
# raises the risk of abandoning slow background work.
# NOTE: the same ceiling also bounds how long a SUBMITTED user turn may stay
# completely silent before the listener gives up (clocked from the submit).
# It is not a background-only budget; lower values also cut off very slow
# first responses.
# NOTE: after a task-completion event drains the ledger between turns, settle
# additionally waits a built-in bounded injection window (30s, or the grace if
# larger) for the CLI's auto-injected follow-up turn — SETTLE_GRACE is a
# floor, not the full worst-case idle lifetime.
# WALKCODE_CLAUDE_SETTLE_GRACE=5             # seconds
# WALKCODE_CLAUDE_BG_WAIT_CEILING=3600       # seconds, 0 disables

# TUI hook freshness window (ADR 0053). Ownership decisions — handing the
# session back to a TUI on a claim hook, or sentinel-killing a takeover
# survivor on an activity hook — only trust hooks whose capture stamp is
# within this many seconds. Must be a finite positive number (inf/nan are
# rejected). To flip a channel-owned session back to a terminal, a claim must
# be fresh OR backed by a live TUI, AND must not predate the current owner's
# acquisition (a claim from before a takeover never undoes it). A deliberate
# post-takeover resume fires a fresh SessionStart, so it is unaffected.
# WALKCODE_TUI_HOOK_FRESH_SECONDS=60         # seconds

# Post-takeover remnant sentinel (ADR 0053). When the channel drives a session
# and a live terminal TUI is detected double-writing it, the sentinel verifies
# identity and terminates the terminal process. Set to 0/false/off/no to
# disable termination — the sentinel then only POSTS a conflict notice
# (notify-only stop-loss), it never goes silent. Default: enabled.
# WALKCODE_TUI_SENTINEL_ENABLED=1

# Handoff continuation (ADR 0051). auto (default): after a takeover-only
# handoff that stale-marked pending prompts, inject an invisible continue
# turn so the agent re-asks and the channel gets a fresh answerable card.
# off: escape hatch (the takeover still succeeds; type to continue).
# WALKCODE_HANDOFF_CONTINUE=auto            # auto|off

# PreToolUse gate (permission / AskUserQuestion loop, ADR 0046 v2/v3).
# dual (default): daemon sessions render the native dialog AND a Feishu card
# at the same time — first answer wins (card answers are keystroke-injected).
# block: whole gate reverts to the v2 blocking style (escape hatch).
# WALKCODE_CLAUDE_GATE_STYLE=dual
# WALKCODE_CLAUDE_GATE_MODE=auto            # auto|off|ask_only
# WALKCODE_CLAUDE_GATE_TIMEOUT=1800         # block path only, seconds
# WALKCODE_CLAUDE_GATE_TOOLS=Bash,Edit,Write,MultiEdit,NotebookEdit

# Optional debug/observability: route this profile's headless Claude sessions
# through a locally running claude-tap (https://github.com/liaohch3/claude-tap)
# reverse-proxy trace viewer. Managed end-to-end by
# scripts/claude-tap-setup.sh (init/apply/remove/status) driven by
# ~/.walkcode/claude-tap/taps.conf — full deployment guide in
# docs/claude-tap-deploy.md, mechanism/rationale in ADR 0047.
# WalkCode merges this profile's settings.json env with the proxy address and
# passes it via an SDK --settings file (0600; plain env is overridden by the
# profile's own settings.json, and a --settings env map replaces the profile
# env wholesale — both confirmed live, hence the merge). Cannot be combined
# with WALKCODE_CLAUDE_SETTINGS on the same profile (rejected at startup).
# WalkCode does not install, launch, or supervise claude-tap itself; once set,
# new headless sessions of this profile hard-depend on the local tap.
# WALKCODE_CLAUDE_ANTHROPIC_BASE_URL=http://127.0.0.1:18899

# Per-profile Codex isolation. Each CODEX_HOME gets its own managed app-server
# daemon and control socket ({CODEX_HOME}/app-server-control/...).
# WALKCODE_CODEX_HOME=/Users/you/.codex-profiles/work
# Optional overrides when config/cache are not under that CODEX_HOME.
# WALKCODE_CODEX_CONFIG=/Users/you/.codex-profiles/work/config.toml
# WALKCODE_CODEX_MODELS_CACHE=/Users/you/.codex-profiles/work/models_cache.json
# Advanced Codex app-server mode. Default auto uses the managed daemon control
# socket only when the Codex standalone daemon install exists; otherwise it
# falls back to stdio. Use daemon to force shared app-server, or stdio for
# local debugging. Unknown values are rejected.
# WALKCODE_CODEX_APP_SERVER_MODE=auto
# WALKCODE_CODEX_APP_SERVER_SOCKET=/Users/you/.codex-profiles/work/app-server-control/app-server-control.sock

# Optional explicit state path (otherwise derived from profile+agent).
# WALKCODE_STATE_PATH=/Users/you/.walkcode/work-claude-state.json

# Optional real-environment gates. Leave disabled unless intentionally running
# real E2E checks (scripts/channel_native_debug.py lark --live).
# WALKCODE_E2E_LARK=1
# WALKCODE_E2E_LARK_CHAT_ID=oc_xxx
# WALKCODE_E2E_CLAUDE_HEADLESS=1
# WALKCODE_E2E_CODEX_APP_SERVER=1
# WALKCODE_E2E_CWD=/Users/you/.walkcode/e2e/channel-native-smoke

# ---------------------------------------------------------------------------
# Telegram remains a peer ChannelAdapter (architecture-validation channel; no
# further UX investment). Use it in a separate env file:
#
# WALKCODE_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
# TELEGRAM_ALLOWED_USER_IDS=456789
# WALKCODE_TELEGRAM_TUI_CHAT_ID=123456789
# WALKCODE_TELEGRAM_TUI_THREAD_ID=77
# WALKCODE_E2E_TELEGRAM=1
# WALKCODE_E2E_TELEGRAM_CHAT_ID=123456789
